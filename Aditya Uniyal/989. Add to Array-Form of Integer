        List<Integer> ans = new ArrayList<>();
        int i = num.length - 1;
        int temp = k;
        int sum = 0;
        int carry = 0;
        while(i >= 0 || temp > 0 || carry > 0){
            sum = carry;
            if(i >= 0){
                sum += num[i];
                i--;
            }       
            if(temp > 0){
                sum += temp % 10;
                temp /= 10;
            }    
            ans.add(sum % 10);
            carry = sum / 10;
        }
        Collections.reverse(ans);
        return ans;
    }
