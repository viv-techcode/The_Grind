class Solution {
    public long minimumSteps(String s) {
        long count = 0;
        int slow = 0;
        char[] arr = s.toCharArray();
        for(int right = 0 ; right < arr.length ; right++){
            if(arr[right] != '1'){
                count += right - slow;
                slow++;
            }
        }
        return count;
    }
}
