class Solution {
    public int[][] generateMatrix(int n) {
        int[][] ans = new int[n][n];
        for(int[] rows : ans){
            Arrays.fill(rows , -1);
        }
        int top = 0;
        int left = 0;
        int right = ans[0].length - 1;
        int bottom = ans.length - 1;
        int ind = 1;
        while(top <= bottom && left <= right){ // done
            for(int i = left ; i <= right ; i++){
                ans[top][i] = ind++;
            }
            top++;

            for(int i = top ; i <= bottom ; i++){
                ans[i][right] = ind++;
            }
            right--;

            if(top <= bottom){
                for(int i = right ; i >= left ; i--){
                    ans[bottom][i] = ind++;
                }
                bottom--;
            }

            if(left <= right){
                for(int i = bottom ; i >= top ; i--){
                    ans[i][left] = ind++;
                }
                left++;
            }
        }
        return ans;
    }
}
