class Solution {
    public String mergeAlternately(String word1, String word2) {
        char[] arr1 = word1.toCharArray();
        char[] arr2 = word2.toCharArray();
        int i = 0;
        int j = 0;
        StringBuilder ans = new StringBuilder();
        while(i < arr1.length && j < arr2.length){
            ans.append(arr1[i]);
            ans.append(arr2[j]);
            i++;
            j++;
        }
        while(i != arr1.length){
            ans.append(arr1[i]);
            i++;
        }
        while(j != arr2.length){
            ans.append(arr2[j]);
            j++;
        }
        return new String(ans);
    }
}
